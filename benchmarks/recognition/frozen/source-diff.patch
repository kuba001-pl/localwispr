+        let core = left_trimmed.trim_end_matches([',', '.', '!', '?', ':', ';']);
+        if ((core.starts_with('[') && core.ends_with(']'))
+            || (core.starts_with('(') && core.ends_with(')')))
+            || core.contains('_')
+            || core.contains("::")
+            || core.starts_with("--")
+            || matches!(core, "em" | "er" | "EM" | "ER" | "mm" | "MM")
