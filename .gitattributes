# Keep historical evidence available while focusing PR review on implementation.
benchmarks/**/results/** linguist-generated=true
benchmarks/**/frozen/** linguist-generated=true
benchmarks/verification/*results.jsonl linguist-generated=true
# Unified-diff context lines intentionally contain a single space; preserve the
# exact archived patch bytes used by source hashes.
benchmarks/**/frozen/source-diff.patch -whitespace
# Python csv.writer's standard CRLF terminators are part of archived evidence.
benchmarks/**/results/*.csv whitespace=cr-at-eol
